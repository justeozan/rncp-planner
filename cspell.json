{
  "version": "0.2",
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "enableGlobDot": true,
  "words": [
    "tailwindcss",
    "clsx",
    "fortytwo",
    "cursus",
    "rncp",
    "dotenv",
    "levelname",
    "lucide",
    "zustand",
    "tanstack",
    "embla",
    "partialize",
    "gomoku",
    "nums",
    "navigations",
    "shadcn",
    "optimise",
    "projet",
    "projets",
  ],
  "useGitignore": true,
  "ignorePaths": [
    "cspell.json",
    ".git/**",
    ".gitignore",
    ".github/workflows/*",
    "package.json",
    "package-lock.json",
    "scripts/**",
    "optimizer/**",
    "/src/components/ui/**",
    "data/*",
    "src/data/planner.json",
    "public/*",
    ".dockerignore",
    "Dockerfile",
    "compose.yaml",
  ]
}
